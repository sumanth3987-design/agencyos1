# Flask environment (development or production)
# Unset or missing values resolve to "production".
FLASK_ENV=development

# Required: strong, unique, high-entropy secret key of at least 32 characters.
# Generate locally and never commit a real value.
# Example (do not use this value): SECRET_KEY=<32+ random characters>
SECRET_KEY=

# SQLAlchemy database URI. Defaults to sqlite:///agencyos.db if unset.
DATABASE_URL=sqlite:///agencyos.db

# Razorpay integration
# RAZORPAY_KEY_ID is public-facing and can be included in client-side templates.
# RAZORPAY_KEY_SECRET must remain server-side only. Never log or commit it.
# Use test mode credentials for local development.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
