# Flask environment (development or production)
# Unset or missing values resolve to "production".
FLASK_ENV=development

# Required: strong, unique, high-entropy secret key of at least 32 characters.
# Generate locally and never commit a real value.
# Example (do not use this value): SECRET_KEY=<32+ random characters>
SECRET_KEY=

# SQLAlchemy database URI. Defaults to sqlite:///agencyos.db if unset.
DATABASE_URL=sqlite:///agencyos.db

# Razorpay integration
# RAZORPAY_KEY_ID is public-facing and can be included in client-side templates.
# RAZORPAY_KEY_SECRET must remain server-side only. Never log or commit it.
# Use test mode credentials for local development.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Account recovery and email verification
MAIL_BACKEND=console
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=no-reply@agencyos.local
MAIL_SUPPRESS_SEND=false
PASSWORD_RESET_TOKEN_EXPIRY_MINUTES=30
EMAIL_VERIFICATION_TOKEN_EXPIRY_HOURS=24
EMAIL_VERIFICATION_REQUIRED=false

# Rate limiting storage
# Use memory:// for local single-process development and isolated tests.
# Production multi-worker deployments must use shared Redis storage.
# RATELIMIT_STORAGE_URL=redis://redis-host:6379/0
RATELIMIT_STORAGE_URL=memory://
# Trusted public origin for password-reset and verification links.
# APP_BASE_URL=https://agencyos.example.com

# Permit in-memory rate-limit storage in production only for one worker.
RATELIMIT_ALLOW_IN_MEMORY_STORAGE=false
